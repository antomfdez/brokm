// std/str.bk - string utilities for the brokm standard library.
//
// brokm modules share one flat namespace, so every public name here is
// prefixed Str. Strings are interned, so == compares contents directly.
// Builds only on the C natives CharAt/Chr/Substr/IndexOf/Len.

// StrIsSpace(c) - is the char code a space, tab, CR, or LF?
Bool StrIsSpace(I64 c)
{
  return c == 32 || c == 9 || c == 10 || c == 13;
}

// StrContains(s, sub) - does s contain sub?
Bool StrContains(U8 s, U8 sub)
{
  return IndexOf(s, sub) >= 0;
}

// StrStartsWith(s, prefix)
Bool StrStartsWith(U8 s, U8 prefix)
{
  return Substr(s, 0, Len(prefix)) == prefix;
}

// StrEndsWith(s, suffix)
Bool StrEndsWith(U8 s, U8 suffix)
{
  if (Len(suffix) > Len(s)) return FALSE;
  return Substr(s, Len(s) - Len(suffix), Len(suffix)) == suffix;
}

// StrIndexOfFrom(s, sub, from) - first index of sub at or after `from`, or -1.
I64 StrIndexOfFrom(U8 s, U8 sub, I64 from)
{
  if (from < 0) from = 0;
  if (from > Len(s)) return -1;
  I64 at = IndexOf(Substr(s, from, Len(s) - from), sub);
  if (at < 0) return -1;
  return at + from;
}

// StrTrimLeft(s) - drop leading whitespace.
U8 StrTrimLeft(U8 s)
{
  I64 a = 0;
  while (a < Len(s) && StrIsSpace(CharAt(s, a))) ++a;
  return Substr(s, a, Len(s) - a);
}

// StrTrimRight(s) - drop trailing whitespace.
U8 StrTrimRight(U8 s)
{
  I64 b = Len(s);
  while (b > 0 && StrIsSpace(CharAt(s, b - 1))) b = b - 1;
  return Substr(s, 0, b);
}

// StrTrim(s) - drop leading and trailing whitespace.
U8 StrTrim(U8 s)
{
  return StrTrimRight(StrTrimLeft(s));
}

// StrSplit(s, sep) - split s on every occurrence of sep; returns an array of
// the pieces. An empty separator returns [s].
U0[] StrSplit(U8 s, U8 sep)
{
  U0[] parts = [];
  if (Len(sep) == 0) {
    Append(parts, s);
    return parts;
  }
  U8 rest = s;
  I64 at = IndexOf(rest, sep);
  while (at >= 0) {
    Append(parts, Substr(rest, 0, at));
    rest = Substr(rest, at + Len(sep), Len(rest));
    at = IndexOf(rest, sep);
  }
  Append(parts, rest);
  return parts;
}

// StrJoin(parts, sep) - concatenate the parts with sep between them.
// Non-string elements are rendered with ToStr, so int arrays join too.
U8 StrJoin(U0[] parts, U8 sep)
{
  U8 out = "";
  I64 i = 0;
  for (i = 0; i < Len(parts); ++i) {
    if (i > 0) out = out + sep;
    out = out + ToStr(parts[i]);
  }
  return out;
}

// StrReplace(s, from, to) - replace every occurrence of `from` with `to`.
U8 StrReplace(U8 s, U8 from, U8 to)
{
  if (Len(from) == 0) return s;
  U8 out = "";
  U8 rest = s;
  I64 at = IndexOf(rest, from);
  while (at >= 0) {
    out = out + Substr(rest, 0, at) + to;
    rest = Substr(rest, at + Len(from), Len(rest));
    at = IndexOf(rest, from);
  }
  return out + rest;
}

// StrRepeat(s, n) - s concatenated n times.
U8 StrRepeat(U8 s, I64 n)
{
  U8 out = "";
  I64 i = 0;
  for (i = 0; i < n; ++i) out = out + s;
  return out;
}

// StrPadLeft(s, width, pad) - left-pad with `pad` until at least `width` long.
U8 StrPadLeft(U8 s, I64 width, U8 pad)
{
  if (Len(pad) == 0) return s;
  U8 out = s;
  while (Len(out) < width) out = pad + out;
  return out;
}

// StrPadRight(s, width, pad) - right-pad with `pad` until at least `width` long.
U8 StrPadRight(U8 s, I64 width, U8 pad)
{
  if (Len(pad) == 0) return s;
  U8 out = s;
  while (Len(out) < width) out = out + pad;
  return out;
}

// StrCmp(a, b) - lexicographic byte comparison: -1, 0, or 1. The VM's < and >
// are numeric-only, so string ordering lives here.
I64 StrCmp(U8 a, U8 b)
{
  I64 i = 0;
  while (i < Len(a) && i < Len(b)) {
    I64 ca = CharAt(a, i);
    I64 cb = CharAt(b, i);
    if (ca < cb) return -1;
    if (ca > cb) return 1;
    ++i;
  }
  if (Len(a) < Len(b)) return -1;
  if (Len(a) > Len(b)) return 1;
  return 0;
}

// StrUpper(s) - ASCII uppercase.
U8 StrUpper(U8 s)
{
  U8 out = "";
  I64 i = 0;
  for (i = 0; i < Len(s); ++i) {
    I64 c = CharAt(s, i);
    if (c >= 'a' && c <= 'z') c = c - 32;
    out = out + Chr(c);
  }
  return out;
}

// StrLower(s) - ASCII lowercase.
U8 StrLower(U8 s)
{
  U8 out = "";
  I64 i = 0;
  for (i = 0; i < Len(s); ++i) {
    I64 c = CharAt(s, i);
    if (c >= 'A' && c <= 'Z') c = c + 32;
    out = out + Chr(c);
  }
  return out;
}
