// sample.bk — a real brokm program that also lies within the subset the
// in-brokm compiler (examples/realcc.bk) understands. Running it directly (the
// C compiler) and compiling it with realcc both produce identical output, which
// is what `make test-selfcompile` and tests/cases/selfhost14.bk check.
//
// To stay in the intersection of the two grammars it uses typed declarations
// throughout (brokm requires variables to be declared). Instances are declared
// with their class as the type (`Counter c = Counter(0);`), class-typed
// parameters (`Point a`) and a self-referential field (`Node next`) too — all
// of which realcc now understands.

I64 Fib(I64 n) {
  if (n < 2) { return n; }
  return Fib(n - 1) + Fib(n - 2);
}

I64 Gcd(I64 a, I64 b) {
  while (b != 0) {
    I64 t = b;
    b = a % b;
    a = t;
  }
  return a;
}

class Counter {
  I64 n;
  U0 Inc() { this.n = this.n + 1; }
  U0 Add(I64 k) { this.n = this.n + k; }
  I64 Get() { return this.n; }
}

U0 Classify(I64 d) {
  switch (d) {
    case 0: "zero\n"; break;
    case 1: "one\n"; break;
    case 2: "two\n"; break;
    default: "many\n";
  }
}

// Forward declaration (prototype): Grade is used by Sign before it is defined.
U8 Grade(I64 score);

U8 Sign(I64 score) { return Grade(score); }

U8 Grade(I64 score) {
  if (score >= 90) { return "A"; }
  else if (score >= 80) { return "B"; }
  else if (score >= 70) { return "C"; }
  else { return "F"; }
}

class Point { I64 x; I64 y; }

I64 ManhattanDist(Point a, Point b) {
  return Abs(a.x - b.x) + Abs(a.y - b.y);
}

class Node { I64 val; Node next; }

I64 SumList(Node head) {
  if (head == NULL) { return 0; }
  return head.val + SumList(head.next);
}

I64 PopCount(I64 x) {
  I64 count = 0;
  while (x != 0) {
    count = count + (x & 1);
    x = x >> 1;
  }
  return count;
}

I64 IsEven(I64 x) { return (x & 1) == 0; }

"== Fib ==\n";
I64 i = 0;
for (i = 0; i < 8; i = i + 1) {
  "Fib(%d) = %d\n", i, Fib(i);
}

"== Gcd ==\n";
"Gcd(48, 36) = %d\n", Gcd(48, 36);
"Gcd(1071, 462) = %d\n", Gcd(1071, 462);

"== Counter ==\n";
Counter c = Counter(0);
i = 0;
while (i < 5) { c.Inc(); i = i + 1; }
c.Add(100);
"counter = %d\n", c.Get();

"== Points ==\n";
Point p1 = Point(1, 2);
Point p2 = Point(4, 6);
"dist = %d\n", ManhattanDist(p1, p2);

"== List ==\n";
Node lst = Node(10, Node(20, Node(30, NULL)));
"sum = %d\n", SumList(lst);

"== Bits ==\n";
"12 & 10 = %d\n", 12 & 10;
"1 << 8 = %d\n", 1 << 8;
"flags = %d\n", (1 << 0) | (1 << 2) | (1 << 4);
"popcount(255) = %d\n", PopCount(255);
"5 even? %d  8 even? %d\n", IsEven(5), IsEven(8);
"guard = %d\n", 1 < 2 && 3 < 4 || 0;

"== Classify ==\n";
i = 0;
for (i = 0; i < 4; i = i + 1) { Classify(i); }

"== Grades ==\n";
"95 -> %s\n", Sign(95);
"82 -> %s\n", Sign(82);
"71 -> %s\n", Grade(71);
"40 -> %s\n", Grade(40);
