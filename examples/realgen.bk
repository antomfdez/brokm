// realgen.bk — compile a small language to brokm's REAL bytecode and run it on
// the C VM (self-hosting step 4 demo). Each CompileSource(...) returns an
// ordinary callable function whose body is brokm-generated bytecode; calling it
// executes on the same VM as everything else.

#include "asmlib.bk"

"-- toy programs compiled to real brokm bytecode, run on the C VM --\n";

U0 p1 = CompileSource("print 2 + 3 * 4;");
p1();                                                   // 14

U0 p2 = CompileSource("x = 10; y = x * x; print y - 1;");
p2();                                                   // 99

U0 p3 = CompileSource("print -5 + 8; print (2 + 3) * 4; print 17 % 5;");
p3();                                                   // 3, 20, 2
