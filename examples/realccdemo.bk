// realccdemo.bk — compile a small imperative language (with if/else and while)
// to brokm's REAL bytecode and run it on the C VM (self-hosting step 5 demo).
// Each Compile(...) returns an ordinary callable whose body is brokm-generated
// real bytecode, jumps and all.

#include "realcc.bk"

"-- if/else + while compiled to real brokm bytecode, run on the C VM --\n";

// Sum 1..100 with a while loop.
U0 sumProg = Compile("sum = 0; i = 1; while (i <= 100) { sum = sum + i; i = i + 1; } print sum;");
sumProg();                                              // 5050

// 6! with a while loop.
U0 factProg = Compile("f = 1; k = 1; while (k <= 6) { f = f * k; k = k + 1; } print f;");
factProg();                                             // 720

// Classify the numbers 1..7 by parity using if/else.
U0 parityProg = Compile("
  n = 1;
  while (n <= 7) {
    if (n % 2 == 0) { print n; } else { print -n; }
    n = n + 1;
  }
");
parityProg();                                           // -1 2 -3 4 -5 6 -7

// Function definitions, recursion, and mutual recursion (step 6). Parameters
// live in real local slots, so recursion works.
U0 fnProg = Compile("
  func fib(n)  { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
  func fact(n) { if (n < 2) { return 1; } return n * fact(n - 1); }
  func even(n) { if (n == 0) { return 1; } return odd(n - 1); }
  func odd(n)  { if (n == 0) { return 0; } return even(n - 1); }
  print fib(10);
  print fact(6);
  print even(10);
  print odd(10);
");
fnProg();                                               // 55 720 1 0

// Function-scoped local variables (step 7): `a` and `m` are per-call locals,
// so these recursive functions — which read a temporary across a recursive
// call — give the right answers instead of clobbering a shared global.
U0 localProg = Compile("
  func fibm(n) { if (n < 2) { return n; } a = fibm(n - 1); b = fibm(n - 2); return a + b; }
  func fac(n)  { if (n <= 1) { return 1; } m = n; return fac(n - 1) * m; }
  print fibm(12);
  print fac(7);
");
localProg();                                            // 144 5040

// Arrays (step 8): literals, index get/set, native Append/Len, and a sieve of
// Eratosthenes that prints the primes below 20.
U0 arrayProg = Compile("
  func primes(limit) {
    sieve = [];
    i = 0;
    while (i < limit) { Append(sieve, 1); i = i + 1; }
    p = 2;
    while (p < limit) {
      if (sieve[p] == 1) {
        m = p + p;
        while (m < limit) { sieve[m] = 0; m = m + p; }
      }
      p = p + 1;
    }
    n = 2;
    while (n < limit) { if (sieve[n] == 1) { print n; } n = n + 1; }
    return 0;
  }
  primes(20);
");
arrayProg();                                            // 2 3 5 7 11 13 17 19

// Strings (step 9): literals, concatenation, and the native Print, with labels
// in front of computed numbers.
U0 strProg = Compile("
  Print(\"-- strings --\n\");
  who = \"brokm\";
  Print(\"hello, \" + who + \"!\n\");
  func fact(n) { if (n <= 1) { return 1; } return n * fact(n - 1); }
  Print(\"5! = \"); print fact(5);
");
strProg();                                              // hello, brokm! / 5! = 120

// Type annotations + maps (step 10): brokm-style typed declarations, parsed and
// discarded, alongside a string-keyed map built from the native stdlib.
U0 typedProg = Compile("
  U0 gcd(I64 a, I64 b) { while (b != 0) { I64 t = b; b = a % b; a = t; } return a; }
  Print(\"gcd(48,36) = \"); print gcd(48, 36);

  U0[] ages = MapNew();
  MapSet(ages, \"ada\", 36);
  Print(\"ada is \"); print MapGet(ages, \"ada\");
");
typedProg();                                            // gcd(48,36) = 12 / ada is 36
