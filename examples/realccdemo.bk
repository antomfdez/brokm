// realccdemo.bk — compile a small imperative language (with if/else and while)
// to brokm's REAL bytecode and run it on the C VM (self-hosting step 5 demo).
// Each Compile(...) returns an ordinary callable whose body is brokm-generated
// real bytecode, jumps and all.

#include "realcc.bk"

"-- if/else + while compiled to real brokm bytecode, run on the C VM --\n";

// Sum 1..100 with a while loop.
U0 sumProg = Compile("sum = 0; i = 1; while (i <= 100) { sum = sum + i; i = i + 1; } print sum;");
sumProg();                                              // 5050

// 6! with a while loop.
U0 factProg = Compile("f = 1; k = 1; while (k <= 6) { f = f * k; k = k + 1; } print f;");
factProg();                                             // 720

// Classify the numbers 1..7 by parity using if/else.
U0 parityProg = Compile("
  n = 1;
  while (n <= 7) {
    if (n % 2 == 0) { print n; } else { print -n; }
    n = n + 1;
  }
");
parityProg();                                           // -1 2 -3 4 -5 6 -7

// Function definitions, recursion, and mutual recursion (step 6). Parameters
// live in real local slots, so recursion works.
U0 fnProg = Compile("
  func fib(n)  { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
  func fact(n) { if (n < 2) { return 1; } return n * fact(n - 1); }
  func even(n) { if (n == 0) { return 1; } return odd(n - 1); }
  func odd(n)  { if (n == 0) { return 0; } return even(n - 1); }
  print fib(10);
  print fact(6);
  print even(10);
  print odd(10);
");
fnProg();                                               // 55 720 1 0

// Function-scoped local variables (step 7): `a` and `m` are per-call locals,
// so these recursive functions — which read a temporary across a recursive
// call — give the right answers instead of clobbering a shared global.
U0 localProg = Compile("
  func fibm(n) { if (n < 2) { return n; } a = fibm(n - 1); b = fibm(n - 2); return a + b; }
  func fac(n)  { if (n <= 1) { return 1; } m = n; return fac(n - 1) * m; }
  print fibm(12);
  print fac(7);
");
localProg();                                            // 144 5040

// Arrays (step 8): literals, index get/set, native Append/Len, and a sieve of
// Eratosthenes that prints the primes below 20.
U0 arrayProg = Compile("
  func primes(limit) {
    sieve = [];
    i = 0;
    while (i < limit) { Append(sieve, 1); i = i + 1; }
    p = 2;
    while (p < limit) {
      if (sieve[p] == 1) {
        m = p + p;
        while (m < limit) { sieve[m] = 0; m = m + p; }
      }
      p = p + 1;
    }
    n = 2;
    while (n < limit) { if (sieve[n] == 1) { print n; } n = n + 1; }
    return 0;
  }
  primes(20);
");
arrayProg();                                            // 2 3 5 7 11 13 17 19

// Strings (step 9): literals, concatenation, and the native Print, with labels
// in front of computed numbers.
U0 strProg = Compile("
  Print(\"-- strings --\n\");
  who = \"brokm\";
  Print(\"hello, \" + who + \"!\n\");
  func fact(n) { if (n <= 1) { return 1; } return n * fact(n - 1); }
  Print(\"5! = \"); print fact(5);
");
strProg();                                              // hello, brokm! / 5! = 120

// Type annotations + maps (step 10): brokm-style typed declarations, parsed and
// discarded, alongside a string-keyed map built from the native stdlib.
U0 typedProg = Compile("
  U0 gcd(I64 a, I64 b) { while (b != 0) { I64 t = b; b = a % b; a = t; } return a; }
  Print(\"gcd(48,36) = \"); print gcd(48, 36);

  U0[] ages = MapNew();
  MapSet(ages, \"ada\", 36);
  Print(\"ada is \"); print MapGet(ages, \"ada\");
");
typedProg();                                            // gcd(48,36) = 12 / ada is 36

// Structs/classes (step 11): a declaration, construction, field access, and a
// self-referential linked list summed by recursion.
U0 structProg = Compile("
  Print(\"-- structs --\n\");
  class Vec2 { I64 x; I64 y; }
  func dot(a, b) { return a.x * b.x + a.y * b.y; }
  Print(\"dot = \"); print dot(Vec2(1, 2), Vec2(3, 4));

  class Cons { I64 head; U0 tail; }
  func sum(xs) { if (xs == NULL) { return 0; } return xs.head + sum(xs.tail); }
  Print(\"sum = \"); print sum(Cons(5, Cons(7, Cons(9, NULL))));
");
structProg();                                           // dot = 11 / sum = 21

// Methods (step 12): classes with behaviour, an implicit `this` receiver,
// sibling method calls, and reference semantics — all invoked via OP_INVOKE.
U0 methodProg = Compile("
  Print(\"-- methods --\n\");
  class Counter {
    I64 n;
    func Inc() { this.n = this.n + 1; }
    func IncTwice() { this.Inc(); this.Inc(); }
    I64 Get() { return this.n; }
  }
  func Bump(c) { c.Inc(); }
  c = Counter(0);
  c.IncTwice();
  Bump(c);
  Print(\"counter = \"); print c.Get();

  class Account {
    I64 balance;
    func Deposit(a) { this.balance = this.balance + a; }
    func Withdraw(a) { if (a <= this.balance) { this.balance = this.balance - a; } }
    I64 Balance() { return this.balance; }
  }
  acct = Account(100);
  acct.Deposit(50);
  acct.Withdraw(30);
  Print(\"balance = \"); print acct.Balance();
");
methodProg();                                           // counter = 3 / balance = 120

// Loops (step 13): `for` (at top level and inside a function) and `do`-`while`.
U0 loopProg = Compile("
  Print(\"-- loops --\n\");
  sum = 0;
  for (i = 1; i <= 10; i = i + 1) { sum = sum + i; }
  Print(\"sum 1..10 = \"); print sum;

  func power(base, exp) {
    result = 1;
    for (e = 0; e < exp; e = e + 1) { result = result * base; }
    return result;
  }
  Print(\"2^10 = \"); print power(2, 10);

  n = 1; count = 0;
  do { count = count + 1; n = n * 2; } while (n < 1000);
  Print(\"doublings to 1000 = \"); print count;
");
loopProg();                                             // sum 1..10 = 55 / 2^10 = 1024 / doublings = 10

// Switch (step 14): C-style fallthrough, break, and default, with a FizzBuzz-ish
// classifier driven by a while loop over 1..7.
U0 switchProg = Compile("
  Print(\"-- switch --\n\");
  func name(d) {
    switch (d) {
      case 1: Print(\"one\n\"); break;
      case 2: Print(\"two\n\"); break;
      case 3: Print(\"three\n\"); break;
      default: Print(\"many\n\");
    }
  }
  i = 1;
  while (i <= 5) { name(i); i = i + 1; }
");
switchProg();                                           // one / two / three / many / many

// HolyC print (step 15): a leading string literal is a print statement, with
// printf-style trailing args — exactly as brokm's own grammar spells it.
U0 printProg = Compile("
  \"-- HolyC printing --\n\";
  lang = \"brokm\";
  \"%s squares:\n\", lang;
  func sq(n) { return n * n; }
  i = 1;
  while (i <= 5) { \"  %d -> %d\n\", i, sq(i); i = i + 1; }
");
printProg();                                            // brokm squares: 1->1 2->4 3->9 4->16 5->25
