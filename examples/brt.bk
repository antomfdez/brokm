// brt.bk — the first seed of a brokm-written runtime for brokm bytecode.
//
// This is intentionally small: it interprets a narrow subset of the real VM's
// bytecode by reading an ObjFunction with ChunkCode/ChunkConsts. The goal is to
// grow runtime ownership in brokm one opcode family at a time, without touching
// the production C VM or the self-hosting compiler.

I64 BRT_CONSTANT        = Opcode("CONSTANT");
I64 BRT_NIL             = Opcode("NIL");
I64 BRT_POP             = Opcode("POP");
I64 BRT_DEFINE_GLOBAL   = Opcode("DEFINE_GLOBAL");
I64 BRT_GET_GLOBAL      = Opcode("GET_GLOBAL");
I64 BRT_GET_LOCAL       = Opcode("GET_LOCAL");
I64 BRT_SET_LOCAL       = Opcode("SET_LOCAL");
I64 BRT_EQUAL           = Opcode("EQUAL");
I64 BRT_NOT_EQUAL       = Opcode("NOT_EQUAL");
I64 BRT_GREATER         = Opcode("GREATER");
I64 BRT_GREATER_EQUAL   = Opcode("GREATER_EQUAL");
I64 BRT_LESS            = Opcode("LESS");
I64 BRT_LESS_EQUAL      = Opcode("LESS_EQUAL");
I64 BRT_ADD             = Opcode("ADD");
I64 BRT_SUB             = Opcode("SUB");
I64 BRT_MUL             = Opcode("MUL");
I64 BRT_DIV             = Opcode("DIV");
I64 BRT_MOD             = Opcode("MOD");
I64 BRT_NEGATE          = Opcode("NEGATE");
I64 BRT_NOT             = Opcode("NOT");
I64 BRT_JUMP            = Opcode("JUMP");
I64 BRT_JUMP_IF_FALSE   = Opcode("JUMP_IF_FALSE");
I64 BRT_JUMP_IF_TRUE    = Opcode("JUMP_IF_TRUE");
I64 BRT_LOOP            = Opcode("LOOP");
I64 BRT_CALL            = Opcode("CALL");
I64 BRT_PRINT           = Opcode("PRINT");
I64 BRT_ARRAY           = Opcode("ARRAY");
I64 BRT_INDEX_GET       = Opcode("INDEX_GET");
I64 BRT_INDEX_SET       = Opcode("INDEX_SET");
I64 BRT_RETURN          = Opcode("RETURN");
I64 BRT_CONSTANT_W      = Opcode("CONSTANT_W");
I64 BRT_DEFINE_GLOBAL_W = Opcode("DEFINE_GLOBAL_W");
I64 BRT_GET_GLOBAL_W    = Opcode("GET_GLOBAL_W");

I64 BRT_ReadU16(U0[] code, I64 ip)
{
  return (code[ip] << 8) | code[ip + 1];
}

U0 BRT_Print(U0[] stack, I64 sp, I64 argc)
{
  I64 base = sp - argc;
  if (argc == 1) { Print(stack[base]); return; }
  if (argc == 2) { Print(stack[base], stack[base + 1]); return; }
  if (argc == 3) { Print(stack[base], stack[base + 1], stack[base + 2]); return; }
  if (argc == 4) { Print(stack[base], stack[base + 1], stack[base + 2], stack[base + 3]); return; }
  if (argc == 5) { Print(stack[base], stack[base + 1], stack[base + 2], stack[base + 3], stack[base + 4]); return; }
  PrintErr("brt: OP_PRINT arity not implemented: %d\n", argc);
}

U0 BRT_RunFunctionWithGlobals(U0 fn, U0[] args, U0 globals);

U0 BRT_RunFrame(U0 fn, U0 globals, U0[] stack, I64 sp)
{
  U0[] code = ChunkCode(fn);
  U0[] consts = ChunkConsts(fn);
  I64 ip = 0;

  while (ip < Len(code)) {
    I64 op = code[ip];
    ip = ip + 1;

    if (op == BRT_CONSTANT) {
      if (sp < Len(stack)) stack[sp] = consts[code[ip]];
      else Append(stack, consts[code[ip]]);
      sp = sp + 1;
      ip = ip + 1;
    } else if (op == BRT_CONSTANT_W) {
      if (sp < Len(stack)) stack[sp] = consts[BRT_ReadU16(code, ip)];
      else Append(stack, consts[BRT_ReadU16(code, ip)]);
      sp = sp + 1;
      ip = ip + 2;
    } else if (op == BRT_NIL) {
      if (sp < Len(stack)) stack[sp] = NULL;
      else Append(stack, NULL);
      sp = sp + 1;
    } else if (op == BRT_POP) {
      sp = sp - 1;
    } else if (op == BRT_DEFINE_GLOBAL) {
      sp = sp - 1;
      MapSet(globals, consts[code[ip]], stack[sp]);
      ip = ip + 1;
    } else if (op == BRT_DEFINE_GLOBAL_W) {
      sp = sp - 1;
      MapSet(globals, consts[BRT_ReadU16(code, ip)], stack[sp]);
      ip = ip + 2;
    } else if (op == BRT_GET_GLOBAL) {
      if (sp < Len(stack)) stack[sp] = MapGet(globals, consts[code[ip]]);
      else Append(stack, MapGet(globals, consts[code[ip]]));
      sp = sp + 1;
      ip = ip + 1;
    } else if (op == BRT_GET_GLOBAL_W) {
      if (sp < Len(stack)) stack[sp] = MapGet(globals, consts[BRT_ReadU16(code, ip)]);
      else Append(stack, MapGet(globals, consts[BRT_ReadU16(code, ip)]));
      sp = sp + 1;
      ip = ip + 2;
    } else if (op == BRT_GET_LOCAL) {
      if (sp < Len(stack)) stack[sp] = stack[code[ip]];
      else Append(stack, stack[code[ip]]);
      sp = sp + 1;
      ip = ip + 1;
    } else if (op == BRT_SET_LOCAL) {
      stack[code[ip]] = stack[sp - 1];
      ip = ip + 1;
    } else if (op == BRT_EQUAL) {
      stack[sp - 2] = stack[sp - 2] == stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_NOT_EQUAL) {
      stack[sp - 2] = stack[sp - 2] != stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_GREATER) {
      stack[sp - 2] = stack[sp - 2] > stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_GREATER_EQUAL) {
      stack[sp - 2] = stack[sp - 2] >= stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_LESS) {
      stack[sp - 2] = stack[sp - 2] < stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_LESS_EQUAL) {
      stack[sp - 2] = stack[sp - 2] <= stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_ADD) {
      stack[sp - 2] = stack[sp - 2] + stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_SUB) {
      stack[sp - 2] = stack[sp - 2] - stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_MUL) {
      stack[sp - 2] = stack[sp - 2] * stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_DIV) {
      stack[sp - 2] = stack[sp - 2] / stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_MOD) {
      stack[sp - 2] = stack[sp - 2] % stack[sp - 1];
      sp = sp - 1;
    } else if (op == BRT_NEGATE) {
      stack[sp - 1] = 0 - stack[sp - 1];
    } else if (op == BRT_NOT) {
      stack[sp - 1] = !stack[sp - 1];
    } else if (op == BRT_JUMP) {
      ip = ip + BRT_ReadU16(code, ip) + 2;
    } else if (op == BRT_JUMP_IF_FALSE) {
      I64 off = BRT_ReadU16(code, ip);
      ip = ip + 2;
      if (!stack[sp - 1]) ip = ip + off;
    } else if (op == BRT_JUMP_IF_TRUE) {
      I64 off = BRT_ReadU16(code, ip);
      ip = ip + 2;
      if (stack[sp - 1]) ip = ip + off;
    } else if (op == BRT_LOOP) {
      ip = ip - BRT_ReadU16(code, ip) + 2;
    } else if (op == BRT_CALL) {
      I64 argc = code[ip];
      ip = ip + 1;
      U0 callee = stack[sp - argc - 1];
      if (IndexOf(ValueDesc(callee), "fn:") != 0) {
        PrintErr("brt: can only call functions\n");
        return NULL;
      }
      U0[] args = [];
      I64 i = 0;
      while (i < argc) {
        Append(args, stack[sp - argc + i]);
        i = i + 1;
      }
      U0 result = BRT_RunFunctionWithGlobals(callee, args, globals);
      sp = sp - argc - 1;
      if (sp < Len(stack)) stack[sp] = result;
      else Append(stack, result);
      sp = sp + 1;
    } else if (op == BRT_PRINT) {
      I64 argc = code[ip];
      ip = ip + 1;
      BRT_Print(stack, sp, argc);
      sp = sp - argc;
    } else if (op == BRT_ARRAY) {
      I64 n = code[ip];
      ip = ip + 1;
      I64 base = sp - n;
      U0[] arr = [];
      I64 i = 0;
      while (i < n) {
        Append(arr, stack[base + i]);
        i = i + 1;
      }
      sp = base;
      if (sp < Len(stack)) stack[sp] = arr;
      else Append(stack, arr);
      sp = sp + 1;
    } else if (op == BRT_INDEX_GET) {
      U0 arr = stack[sp - 2];
      stack[sp - 2] = arr[stack[sp - 1]];
      sp = sp - 1;
    } else if (op == BRT_INDEX_SET) {
      U0 arr = stack[sp - 3];
      arr[stack[sp - 2]] = stack[sp - 1];
      stack[sp - 3] = stack[sp - 1];
      sp = sp - 2;
    } else if (op == BRT_RETURN) {
      if (sp == 0) return NULL;
      return stack[sp - 1];
    } else {
      PrintErr("brt: opcode not implemented: %d\n", op);
      return NULL;
    }
  }
  return NULL;
}

U0 BRT_RunWithGlobals(U0 fn, U0 globals)
{
  return BRT_RunFrame(fn, globals, [], 0);
}

U0 BRT_Run(U0 fn)
{
  return BRT_RunWithGlobals(fn, MapNew());
}

U0 BRT_RunFunctionWithGlobals(U0 fn, U0[] args, U0 globals)
{
  U0[] stack = [];
  Append(stack, fn);                 // local slot 0, matching the C VM
  I64 i = 0;
  while (i < Len(args)) {
    Append(stack, args[i]);          // parameter slots 1..arity
    i = i + 1;
  }
  return BRT_RunFrame(fn, globals, stack, Len(stack));
}

U0 BRT_RunFunction(U0 fn, U0[] args)
{
  return BRT_RunFunctionWithGlobals(fn, args, MapNew());
}

U0 BRT_FindFunction(U0 script, U8 name, I64 arity)
{
  U8 want = "fn:" + name + "/" + ToStr(arity);
  U0[] consts = ChunkConsts(script);
  I64 i = 0;
  while (i < Len(consts)) {
    if (ValueDesc(consts[i]) == want) return consts[i];
    i = i + 1;
  }
  return NULL;
}

U0 BRT_FindFirstFunction(U0 script, I64 arity)
{
  U8 ar = "/" + ToStr(arity);
  U0[] consts = ChunkConsts(script);
  I64 i = 0;
  while (i < Len(consts)) {
    U8 desc = ValueDesc(consts[i]);
    if (IndexOf(desc, "fn:") == 0 && IndexOf(desc, ar) >= 0) return consts[i];
    i = i + 1;
  }
  return NULL;
}
