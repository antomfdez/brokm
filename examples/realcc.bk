// realcc.bk — a small imperative language compiled to brokm's REAL bytecode.
// Self-hosting steps 4-18: from the Opcode/Assemble bridge (step 4) through
// control flow (step 5), FUNCTION DEFINITIONS with parameters, recursion, and
// calls (step 6), function-scoped LOCAL VARIABLES (step 7), ARRAYS with the
// native stdlib in reach (step 8), STRING literals (step 9), HolyC-style TYPE
// ANNOTATIONS (step 10), STRUCTS/CLASSES (step 11) — `class Point { I64 x; I64
// y; }`, construction `Point(3, 4)`, field access `p.x` / `p.x = v`, built on
// the `MakeClass` native — METHODS (step 12) `obj.m(args)` via `OP_INVOKE` and
// the `AddMethod` native, with the receiver in local slot 0 named `this`, to
// the `for` and `do`-`while` loop forms (step 13). Maps come for free via the
// native MapNew/MapSet/MapGet through the call path.
//
// Both the typed (`I64 x = e;`, `U0 f(I64 n){...}`) and untyped (`x = e;`,
// `func f(n){...}`) declaration forms are accepted, so this is a superset.
//
// A function (or method) is compiled to its OWN chunk and packed — via
// Assemble(code, consts, arity) — into a real, callable ObjFunction. A function
// is bound with OP_DEFINE_GLOBAL and called with OP_CALL; a method is attached
// to its class with AddMethod and invoked with OP_INVOKE. Parameters live in
// real local slots (1..arity; slot 0 is the function itself, or the receiver
// `this` in a method), so recursion works. The only C hooks are the Opcode,
// Assemble, MakeClass, and AddMethod natives; everything else is brokm.
//
// The compiler is split across modules, included below in dependency order
// (types -> lexer -> parser -> code generator). This file is the entry point;
// it is a LIBRARY (no top-level driver) — see examples/realccdemo.bk.
//
// Grammar:
//   stmt   = "func" ident "(" [param ("," param)*] ")" block
//          | "return" expr ";"
//          | "print" expr ";"
//          | string ["," expr]* ";"                   (HolyC printf print)
//          | "if" "(" expr ")" block ["else" block]
//          | "while" "(" expr ")" block
//          | "for" "(" stmt ";" expr ";" assign ")" block
//          | "do" block "while" "(" expr ")" ";"
//          | "switch" "(" expr ")" "{" case* "}"
//          | "break" ";"
//          | "class" ident "{" member* "}"
//          | lvalue "=" expr ";"
//          | expr ";"
//   case   = ("case" expr | "default") ":" stmt*   (C-style fallthrough)
//   member = [type | "func"] ident "(" [param ...] ")" block      (method)
//          | [type] ident ";"                                     (field)
//   block  = "{" stmt* "}"
//   expr   = and  ("||" and)*           // precedence, lowest to highest,
//   and    = bor  ("&&" bor)*           // mirrors brokm: || && | ^ &
//   bor    = bxor ("|" bxor)*           // == != | < > <= >= | << >> |
//   bxor   = band ("^" band)*           // + - | * / % | unary | postfix
//   band   = eq   ("&" eq)*
//   eq     = cmp  (("=="|"!=") cmp)*
//   cmp    = shift (("<"|">"|"<="|">=") shift)*
//   shift  = add  (("<<"|">>") add)*
//   add    = term (("+"|"-") term)*
//   term   = factor (("*"|"/"|"%") factor)*
//   factor = primary (("[" expr "]") | ("." ident ["(" args ")"]))*
//   primary= number | string | ident ["(" args ")"] | "[" args "]"
//          | "(" expr ")" | ("-"|"!"|"~") factor

#include "realcc_types.bk"
#include "realcc_lex.bk"
#include "realcc_parse.bk"
#include "realcc_gen.bk"
