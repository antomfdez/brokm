// realcc_lex.bk — the tokenizer for the realcc self-hosting compiler: turns
// source text into a flat array of Tok values (numbers, identifiers/keywords,
// strings with escapes, and one- or two-character operators). Part of realcc.bk.

// ---- tokenizer -------------------------------------------------------------
U0[] Tokenize(U8 src)
{
  U0[] out = [];
  I64 n = Len(src);
  I64 i = 0;
  while (i < n) {
    I64 c = CharAt(src, i);
    if (IsSpace(c)) {
      i = i + 1;
    } else if (IsDigit(c)) {
      I64 start = i;
      while (i < n && IsDigit(CharAt(src, i))) i = i + 1;
      Append(out, Tok(256, ToInt(Substr(src, start, i - start)), NULL));
    } else if (IsAlpha(c)) {
      I64 start = i;
      while (i < n && IsAlnum(CharAt(src, i))) i = i + 1;
      U8 word = Substr(src, start, i - start);
      if (word == "print")       Append(out, Tok(258, 0, NULL));
      else if (word == "if")     Append(out, Tok(259, 0, NULL));
      else if (word == "else")   Append(out, Tok(260, 0, NULL));
      else if (word == "while")  Append(out, Tok(261, 0, NULL));
      else if (word == "func")   Append(out, Tok(262, 0, NULL));
      else if (word == "return") Append(out, Tok(263, 0, NULL));
      else if (word == "class")  Append(out, Tok(265, 0, NULL));
      else if (word == "NULL")   Append(out, Tok(266, 0, NULL));
      else if (word == "for")    Append(out, Tok(267, 0, NULL));
      else if (word == "do")     Append(out, Tok(268, 0, NULL));
      else                       Append(out, Tok(257, 0, word));
    } else if (c == 34) {              // string literal "..."
      i = i + 1;                       // skip opening quote
      U8 s = "";
      while (i < n && CharAt(src, i) != 34) {
        I64 ch = CharAt(src, i);
        if (ch == 92 && i + 1 < n) {   // backslash escape
          i = i + 1;
          I64 e = CharAt(src, i);
          if (e == 110)      s = s + Chr(10);   // \n
          else if (e == 116) s = s + Chr(9);    // \t
          else if (e == 34)  s = s + Chr(34);   // \"
          else if (e == 92)  s = s + Chr(92);   // \\
          else               s = s + Chr(e);    // unknown: literal char
        } else {
          s = s + Chr(ch);
        }
        i = i + 1;
      }
      i = i + 1;                       // skip closing quote
      Append(out, Tok(264, 0, s));
    } else {
      // Two-character operators: ==, !=, <=, >=.
      I64 nx = 0;
      if (i + 1 < n) nx = CharAt(src, i + 1);
      if (c == 61 && nx == 61)      { Append(out, Tok(280, 0, NULL)); i = i + 2; }
      else if (c == 33 && nx == 61) { Append(out, Tok(281, 0, NULL)); i = i + 2; }
      else if (c == 60 && nx == 61) { Append(out, Tok(282, 0, NULL)); i = i + 2; }
      else if (c == 62 && nx == 61) { Append(out, Tok(283, 0, NULL)); i = i + 2; }
      else { Append(out, Tok(c, 0, NULL)); i = i + 1; }  // single-char token
    }
  }
  Append(out, Tok(0, 0, NULL));   // EOF sentinel
  return out;
}

