// selfhost25: brt.bk handles a tiny native-call allowlist through OP_CALL.
// Len and Append are enough to run array-growing bytecode emitted by realcc.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  I64 GrowScore() {
    U0[] a = [];
    Append(a, 4);
    Append(a, 6);
    Append(a, 8);
    return Len(a) * 100 + a[0] + a[1] + a[2];
  }
");

U0 growScore = BRT_FindFirstFunction(script, 0);

"c-vm:\n";
"score = %d\n", growScore();
"brt:\n";
"score = %d\n", BRT_RunFunction(growScore, []);
