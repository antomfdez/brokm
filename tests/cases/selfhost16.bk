// Self-hosting step 19 — `else if` chains and function prototypes (forward
// declarations) in the in-brokm compiler, both of which realcc's own source
// relies on heavily. `Classify` is declared before `Show` uses it and defined
// afterward; the if/else-if/else ladders pick one branch. realcc's output
// matches the C compiler for the same program.
#include "../../examples/realcc.bk"

U0 prog = Compile("
  I64 Classify(I64 n);
  U0 Show(I64 n) {
    I64 c = Classify(n);
    if (c == 0) { \"%d: zero\n\", n; }
    else if (c == 1) { \"%d: small\n\", n; }
    else if (c == 2) { \"%d: medium\n\", n; }
    else { \"%d: large\n\", n; }
  }
  I64 Classify(I64 n) {
    if (n == 0) { return 0; }
    else if (n < 10) { return 1; }
    else if (n < 100) { return 2; }
    else { return 3; }
  }
  I64 i = 0;
  for (i = 0; i < 5; i = i + 1) { Show(i * i * 7); }
");
prog();
