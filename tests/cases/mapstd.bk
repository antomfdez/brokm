// std/map.bk helpers over the native map primitives.
#include "std/map.bk"

U0 m = MapNew();
MapSet(m, "one", 1);
MapSet(m, "two", 2);
MapSet(m, "three", 3);

// MapGetOr: present key returns its value, absent key returns the fallback.
"%d %d\n", MapGetOr(m, "two", -1), MapGetOr(m, "nope", -1);

// MapKeysSorted: lexicographic, deterministic.
U0[] ks = MapKeysSorted(m);
I64 i = 0;
for (i = 0; i < Len(ks); ++i) "%s\n", ks[i];

// MapValues follows MapKeys order; sum is order-independent.
U0[] vs = MapValues(m);
I64 total = 0;
for (i = 0; i < Len(vs); ++i) total = total + vs[i];
"sum=%d\n", total;

// MapCopy is independent of the original.
U0 c = MapCopy(m);
MapSet(c, "four", 4);
"orig=%d copy=%d\n", MapLen(m), MapLen(c);

// MapMerge: b wins on shared keys, both inputs untouched.
U0 a = MapNew();
MapSet(a, "x", 1);
MapSet(a, "y", 2);
U0 b = MapNew();
MapSet(b, "y", 20);
MapSet(b, "z", 30);
U0 merged = MapMerge(a, b);
"x=%d y=%d z=%d len=%d aLen=%d\n",
  MapGet(merged, "x"), MapGet(merged, "y"), MapGet(merged, "z"),
  MapLen(merged), MapLen(a);
