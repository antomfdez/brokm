// Dynamic arrays: literals, indexing, mutation, Append/Len, nesting.
I64[] a = [10, 20, 30];
"len=%d\n", Len(a);
"%d %d %d\n", a[0], a[1], a[2];
a[1] = 25;
Append(a, 40);
"len=%d sum=", Len(a);
I64 i = 0;
I64 sum = 0;
for (i = 0; i < Len(a); ++i) sum = sum + a[i];
"%d\n", sum;
U0[] w = ["foo", "bar"];
"%s-%s\n", w[0], w[1];
U0[] nested = [[1, 2], [3, 4]];
"%d\n", nested[0][1] + nested[1][0];
