// Self-hosting step 20 — braceless single-statement bodies for control flow
// (`if (c) stmt;`, `else if (c) stmt;`, `while (c) stmt;`, `for (...) stmt;`,
// `do stmt while (c);`), which brokm allows and realcc's own source uses
// pervasively. Mixed with braced blocks in the same program.
#include "../../examples/realcc.bk"

U0 prog = Compile("
  U0 Sign(I64 n) {
    if (n > 0) \"+\n\";
    else if (n < 0) \"-\n\";
    else \"0\n\";
  }
  Sign(7);
  Sign(0);
  Sign(-3);

  I64 sum = 0;
  I64 i = 0;
  for (i = 1; i <= 10; i = i + 1) sum = sum + i;
  \"sum = %d\n\", sum;

  I64 p = 1;
  i = 0;
  while (i < 5) { p = p * 2; i = i + 1; }
  \"2^5 = %d\n\", p;

  I64 k = 0;
  do k = k + 3; while (k < 10);
  \"k = %d\n\", k;
");
prog();
