// selfhost2.bk — self-hosting step 4: a brokm program emits the C VM's REAL
// bytecode and runs it on the C VM directly. #includes the assembler library
// across directories (exercises v0.10 modules); the toy program covers every
// operator (+ - * / %, unary -, parens, variables) so the printed output is a
// deterministic end-to-end check of the generated bytecode.
#include "../../examples/asmlib.bk"

U0 prog = CompileSource("a = 6 * 7; b = (a + 8) / 2; c = b % 7; print a; print b; print c; print a - b; print -c; print 2 + 3 * 4;");
prog();
