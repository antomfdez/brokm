// selfhost29: brt.bk runs realcc-emitted class construction and field access.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  class Point { I64 x; I64 y; }
  p = Point(3, 4);
  print p.x;
  print p.y;
  p.x = 10;
  print p.x + p.y;

  class Rect { I64 w; I64 h; }
  func area(r) { return r.w * r.h; }
  print area(Rect(6, 7));

  class Cons { I64 head; U0 tail; }
  func sum(xs) { if (xs == NULL) { return 0; } return xs.head + sum(xs.tail); }
  func len(xs) { n = 0; while (xs != NULL) { n = n + 1; xs = xs.tail; } return n; }
  list = Cons(10, Cons(20, Cons(30, NULL)));
  print sum(list);
  print len(list);
");

"c-vm:\n";
script();
"brt:\n";
BRT_Run(script);
