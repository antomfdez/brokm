// Self-hosting step 14 — `switch` / `case` / `default` / `break` in the in-brokm
// compiler. Cross-directory #include exercises the module system (v0.10) and the
// split realcc modules. The toy switch is C-style: cases fall through to the next
// unless a `break` ends them, and `default` may sit anywhere in the chain. Covers
// fallthrough, break, default (including no-match), a switch inside a function
// with locals, and a nested switch.
//
// Reminder: the toy language has no `//` comments — keep them at the brokm level.
#include "../../examples/realcc.bk"

U0 prog = Compile("
  func describe(n) {
    result = 0;
    switch (n) {
      case 1: result = 10;
      case 2: result = result + 20; break;
      case 3: result = 30; break;
      default: result = 99;
    }
    return result;
  }
  print describe(1);
  print describe(2);
  print describe(3);
  print describe(5);

  func sign(n) {
    s = 0;
    switch (n) {
      case 0: s = 100; break;
      default: s = 200; break;
    }
    return s;
  }
  print sign(0);
  print sign(9);

  func combine(a, b) {
    r = 0;
    switch (a) {
      case 1:
        switch (b) {
          case 1: r = 11; break;
          default: r = 19; break;
        }
        break;
      default: r = 90;
    }
    return r;
  }
  print combine(1, 1);
  print combine(1, 5);
  print combine(7, 0);
");
prog();
