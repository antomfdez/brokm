// Self-hosting step 3: compile a small program with the brokm-in-brokm compiler
// (#included from examples/), run the generated bytecode, and confirm it agrees
// with a direct tree-walk. The include path resolves relative to this file.
#include "../../examples/complib.bk"

U8 SRC = "a = 6 * 7;\nb = a - 2;\nprint a;\nprint b;\nprint (a + b) / 4;\nprint -b;\n";

U0[] prog = Compile(Parse(SRC));
"slots = %d, instrs = %d\n", nslots, Len(prog);
Disasm(prog);

U0[] outs = Run(prog);
I64 i = 0;
for (i = 0; i < Len(outs); i = i + 1) "out %d = %d\n", i, outs[i];

"match = %d\n", SameInts(outs, Interp(Parse(SRC)));
