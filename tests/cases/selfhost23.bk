// selfhost23: brt.bk handles OP_CALL for brokm function objects, including
// recursion through the same globals table the script initialized.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  I64 Fib(I64 n) {
    if (n < 2) return n;
    return Fib(n - 1) + Fib(n - 2);
  }
");

U0 fib = BRT_FindFirstFunction(script, 1);

"c-vm:\n";
script();
"fib7 = %d\n", fib(7);
"fib10 = %d\n", fib(10);

"brt:\n";
U0 globals = MapNew();
BRT_RunWithGlobals(script, globals);
"fib7 = %d\n", BRT_RunFunctionWithGlobals(fib, [7], globals);
"fib10 = %d\n", BRT_RunFunctionWithGlobals(fib, [10], globals);
