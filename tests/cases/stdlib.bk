// v0.6 standard library: strings + math.

// Strings
"CharAt(brokm,1) = %d\n", CharAt("brokm", 1);   // 'r' = 114
"CharAt oob     = %d\n", CharAt("brokm", 99);   // -1
"Chr(65)        = %s\n", Chr(65);                // A
"Substr         = %s\n", Substr("hello world", 6, 5);
"Substr clamp   = %s\n", Substr("hi", 1, 99);
"IndexOf hit    = %d\n", IndexOf("hello world", "world");
"IndexOf miss   = %d\n", IndexOf("hello", "z");
"ToInt          = %d\n", ToInt("100") + ToInt("23");
"ToStr int      = %s\n", ToStr(42);
"ToStr float    = %s\n", ToStr(3.5);
"ToStr bool/nil = %s %s\n", ToStr(TRUE), ToStr(FALSE);
"Ptr nil        = %p\n", NULL;

// Strings interned, so == compares content
Bool same = Substr("abcd", 0, 2) == "ab";
"eq             = %d\n", same;

// Math
"Abs            = %d %g\n", Abs(-7), Abs(-2.5);
"Min/Max        = %d %d\n", Min(3, 9), Max(3, 9);
"Min/Max float  = %g %g\n", Min(2.5, 1.5), Max(2.5, 1.5);
"Sqrt           = %g\n", Sqrt(144.0);
"Pow            = %g\n", Pow(2.0, 10.0);
"Floor/Ceil     = %g %g\n", Floor(3.7), Ceil(3.2);
