// v0.10.1: array-of-class variable declarations (Node[] xs), previously a
// syntax error that forced you to write U0[] xs.

class Node {
  I64 val;
  I64 Get() { return this.val; }
}

// Top-level array-of-class declaration with an initializer.
Node[] xs = [Node(1), Node(2), Node(3)];
"len       = %d\n", Len(xs);              // 3
"xs[1].val = %d\n", xs[1].val;            // 2 (field through the array)
"xs[2].Get = %d\n", xs[2].Get();          // 3 (method through the array)

// Uninitialized array-of-class slot is nil (like U0[] xs;), then Append.
Node[] more;
"more==NULL= %d\n", more == NULL;         // 1
more = [Node(10)];
Append(more, Node(20));
"more sum  = %d\n", more[0].val + more[1].val; // 30

// Local array-of-class declaration inside a function.
I64 SumVals(Node[] ns) {
  I64 total = 0;
  I64 i = 0;
  while (i < Len(ns)) {
    total = total + ns[i].Get();
    i = i + 1;
  }
  return total;
}
"sum       = %d\n", SumVals(xs);          // 1 + 2 + 3 = 6
