// selfhost27: brt.bk can dispatch the small map/print native allowlist.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  U0[] counts = MapNew();
  MapSet(counts, \"a\", 30);
  MapSet(counts, \"b\", 25);
  Print(\"counts: a=\"); print MapGet(counts, \"a\");
  Print(\"counts: b=\"); print MapGet(counts, \"b\");
  Print(\"has-carol=\"); print MapHas(counts, \"carol\");
  Print(\"len=\"); print MapLen(counts);
");

"c-vm:\n";
script();
"brt:\n";
BRT_Run(script);
