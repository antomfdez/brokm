// selfhost22: brt.bk grows from top-level chunks to real function chunks.
// The function below uses argument/local slots, while-loop branches, comparison
// ops, an if/else return, and arithmetic. It is compiled by realcc, then run by
// the production VM and by brt's brokm-written bytecode interpreter.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  I64 SumTo(I64 n) {
    I64 total = 0;
    I64 i = 0;
    while (i <= n) {
      total = total + i;
      i = i + 1;
    }
    if (total == 15) return total + 100;
    return total;
  }
");

U0 sumTo = BRT_FindFirstFunction(script, 1);

"c-vm:\n";
"sum5 = %d\n", sumTo(5);
"sum7 = %d\n", sumTo(7);
"brt:\n";
"sum5 = %d\n", BRT_RunFunction(sumTo, [5]);
"sum7 = %d\n", BRT_RunFunction(sumTo, [7]);
