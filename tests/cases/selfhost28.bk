// selfhost28: a larger selfhost-style array program runs on brt, including
// Append/Len, nested loops, function calls, index get/set, and mutation.
#include "../../examples/realcc.bk"
#include "../../examples/brt.bk"

U0 script = Compile("
  a = [3, 1, 2];
  print a[0];
  a[1] = 99;
  print a[1];
  print Len(a);

  b = [];
  Append(b, 10);
  Append(b, 20);
  print b[0] + b[1];

  func bsort(a, n) {
    i = 0;
    while (i < n) {
      j = 0;
      while (j < n - 1 - i) {
        if (a[j] > a[j + 1]) { t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
        j = j + 1;
      }
      i = i + 1;
    }
    return a;
  }

  arr = [5, 2, 8, 1, 9, 3];
  bsort(arr, 6);
  k = 0;
  while (k < 6) { print arr[k]; k = k + 1; }
");

"c-vm:\n";
script();
"brt:\n";
BRT_Run(script);
